# Copy to bpctool.env (same folder) and uncomment what you need.
# Read by the launcher when it starts the local runner; real environment
# variables take precedence. Use absolute paths (~ is expanded).

# Root that holds one subfolder per quarterly release (default: ~/BPC Files).
# Load runner defaults picks the newest release subfolder (YYYY-Qn names sort by name).
# BPCTOOL_CATALOG=~/BPC Files

# Pin a specific template workbook instead of discovering it in the release folder.
# BPCTOOL_TEMPLATE=~/BPC Files/2026-Q4/ADO template guideline.xlsx

# Where run outputs go (default: <app>/runner-out). Each org/project gets a subfolder
# holding ado-id-map.csv — keep it; it prevents duplicate catalog work items.
# Set this outside the app folder so upgrading BPCTool cannot remove it.
# BPCTOOL_OUTPUT_DIR=~/BPC Files/_runner-out
